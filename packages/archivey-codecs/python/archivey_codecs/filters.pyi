from typing import Self

from _typeshed import ReadableBuffer as Buffer

class _BranchDecoder:
    def __init__(self, start_offset: int = 0) -> None: ...
    def decode(self, data: Buffer) -> bytes: ...
    def flush(self) -> bytes: ...
    def copy(self) -> Self: ...
    def getstate(self) -> bytes: ...
    @classmethod
    def from_state(cls, state: Buffer) -> Self: ...
    @property
    def total_in(self) -> int: ...
    @property
    def total_out(self) -> int: ...

class Arm64Decoder(_BranchDecoder): ...
class RiscvDecoder(_BranchDecoder): ...
