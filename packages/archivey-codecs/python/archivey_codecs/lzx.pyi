from typing import Self, SupportsIndex

from _typeshed import ReadableBuffer as Buffer

class Decompressor:
    def __init__(
        self, window_bits: SupportsIndex, *, output_size: SupportsIndex | None = None
    ) -> None: ...
    def set_output_size(self, output_size: SupportsIndex) -> None: ...
    def reset(self, output_size: SupportsIndex | None = None) -> None: ...
    def decompress(self, data: Buffer, max_length: SupportsIndex = -1) -> bytes: ...
    def flush(self, max_length: SupportsIndex = -1) -> bytes: ...
    def copy(self) -> Self: ...
    def getstate(self) -> bytes: ...
    @classmethod
    def from_state(cls, state: Buffer) -> Self: ...
    @property
    def eof(self) -> bool: ...
    @property
    def needs_input(self) -> bool: ...
    @property
    def unused_data(self) -> bytes: ...
    @property
    def output_size(self) -> int | None: ...
    @property
    def window_bits(self) -> int: ...
    @property
    def total_in(self) -> int: ...
    @property
    def total_out(self) -> int: ...
