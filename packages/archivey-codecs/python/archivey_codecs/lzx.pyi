from typing import Self

from _typeshed import ReadableBuffer as Buffer

class Decompressor:
    def __init__(self, window_bits: int, *, output_size: int | None = None) -> None: ...
    def set_output_size(self, output_size: int) -> None: ...
    def reset(self, output_size: int | None = None) -> None: ...
    def decompress(self, data: Buffer, max_length: int = -1) -> bytes: ...
    def flush(self, max_length: int = -1) -> bytes: ...
    def copy(self) -> Self: ...
    def getstate(self) -> bytes: ...
    @classmethod
    def from_state(cls, state: Buffer) -> Self: ...
    @property
    def eof(self) -> bool: ...
    @property
    def needs_input(self) -> bool: ...
    @property
    def unused_data(self) -> bytes: ...
    @property
    def output_size(self) -> int | None: ...
    @property
    def window_bits(self) -> int: ...
    @property
    def total_in(self) -> int: ...
    @property
    def error_in(self) -> int | None:
        """After a decode error: the input the failed frame had read when it found
        the error, counted as ``total_in`` counts it; ``None`` before any error."""
    @property
    def total_out(self) -> int: ...
