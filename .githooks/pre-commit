#!/usr/bin/env bash
# Repo pre-commit hook: auto-fix + format staged Python the same way CI checks, and
# check that staged Markdown adds no line over 100 columns.
# Install with: ./scripts/install-git-hooks.sh
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Markdown: checked, not rewritten, since a partly staged file would mix the rewrap
# into what is staged. The message names the fixer.
if git diff --cached --name-only --diff-filter=ACMR -- '*.md' | grep -q .; then
  python3 scripts/checks/check_line_width.py --staged
fi

files=()
while IFS= read -r -d '' f; do
  case "$f" in
    src/* | tests/* | scripts/* | benchmarks/*)
      case "$f" in
        *.py) files+=("$f") ;;
      esac
      ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "pre-commit: uv not found on PATH; cannot run ruff." >&2
  exit 1
fi

uv run --no-sync ruff check --fix -- "${files[@]}"
uv run --no-sync ruff format -- "${files[@]}"
git add -- "${files[@]}"
