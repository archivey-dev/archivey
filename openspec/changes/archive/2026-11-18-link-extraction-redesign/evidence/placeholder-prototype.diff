+    def _fill_placeholders(self, reader: BaseArchiveReader) -> None:
+        """PROTOTYPE: write each excluded source's bytes into the inode its
+        placeholders share, found through any of its names still on disk."""
+        state = self._state
+        for source_id, (source, indexes) in state.placeholders.items():
+            live = [
+                i for i in indexes
+                if state.results[i].status is ExtractionStatus.EXTRACTED
+                and state.results[i].path is not None
+            ]
+            paths = [state.results[i].path for i in live] + list(state.source_paths.get(source_id, {}))
